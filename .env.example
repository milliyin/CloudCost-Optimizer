# PostgreSQL connection string used by the backend API and future migrations.
DATABASE_URL=postgresql+asyncpg://cloudcost:cloudcost@postgres:5432/cloudcost

# Secret used for signing JWT access and refresh tokens in Stage 1.
JWT_SECRET_KEY=replace-with-a-long-random-string

# Access key for the dedicated IAM user created for this project.
AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key-id

# Secret key paired with AWS_ACCESS_KEY_ID for the same IAM user.
AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-access-key

# AWS region used for CloudWatch and resource inventory calls.
AWS_REGION=us-east-1

# Runtime environment name for local vs production-specific behavior.
ENVIRONMENT=development
