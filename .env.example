# PostgreSQL connection string used by the backend API and future migrations.
DATABASE_URL=postgresql+asyncpg://cloudcost:cloudcost@postgres:5432/cloudcost

# Secret used for signing JWT access and refresh tokens in Stage 1.
JWT_SECRET_KEY=replace-with-a-long-random-string

# Access key for the dedicated IAM user created for this project.
AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key-id

# Secret key paired with AWS_ACCESS_KEY_ID for the same IAM user.
AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-access-key

# AWS region used for CloudWatch and resource inventory calls.
AWS_REGION=us-east-1

# Optional dedicated Fernet key for encrypting per-organization AWS credentials.
# Generate with Python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
AWS_CONNECTION_ENCRYPTION_KEY=

# How often the background scheduler should attempt a sync in hours.
AWS_SYNC_INTERVAL_HOURS=6

# How many days of Cost Explorer data the manual/background sync should request.
AWS_COST_LOOKBACK_DAYS=30

# How many trailing hours of CloudWatch metrics to collect for each EC2 instance.
AWS_METRIC_LOOKBACK_HOURS=24

# Period in seconds for each CloudWatch metric sample.
AWS_METRIC_PERIOD_SECONDS=3600

# Minimum EC2 metric sample count required before CPU-based findings are evaluated.
FINDING_MIN_SAMPLE_COUNT=3

# CPU threshold for flagging a running EC2 instance as idle.
FINDING_IDLE_CPU_THRESHOLD_PERCENT=10

# Upper CPU bound for the "underutilized but not idle" detection band.
FINDING_UNDERUTILIZED_CPU_UPPER_PERCENT=25

# CPU threshold for flagging a likely performance mismatch.
FINDING_OVERSIZED_CPU_THRESHOLD_PERCENT=85

# Combined average NetworkIn/NetworkOut threshold for the idle-instance rule.
FINDING_IDLE_NETWORK_AVERAGE_BYTES=1000000

# Runtime environment name for local vs production-specific behavior.
ENVIRONMENT=development
